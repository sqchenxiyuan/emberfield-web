[
  {"label":"balanced_room","inputs":{"wealth":1500,"beauty":3,"space":125,"cleanliness":0},"expected":{"impressiveness":100},"formula":"f(x)=x if abs(x)<1 else sign(x)*(1+ln(abs(x))); factors=[f(W/1500),f(B/3),f(S/125),f(1+min(C,0)/2.5)]; q=0.65*mean(factors)+0.35*min(factors); if q>5*factors[2], q=0.25*q+0.75*5*factors[2]; I=100*q"},
  {"label":"dirty_room","inputs":{"wealth":1500,"beauty":3,"space":125,"cleanliness":-2.5},"expected":{"impressiveness":48.75},"formula":"factors=[1,1,1,0]; I=100*(0.65*0.75+0.35*0)"},
  {"label":"sterile_room_same_impressiveness","inputs":{"wealth":1500,"beauty":3,"space":125,"cleanliness":1},"expected":{"impressiveness":100},"formula":"cleanliness factor=f(1+min(1,0)/2.5)=1; I=100"},
