    {
      "id": "PB03",
      "finding": "ShouldDoNow clears automatic paused state outside TargetCount, rejects manual suspended, permits Forever, and permits RepeatCount only above zero. In TargetCount it sets paused at count>=target if pauseWhenSatisfied, clears paused at count<=unpauseWhenYouHave or when hysteresis is disabled, then requires !paused and count<target. Suspended returns before target reevaluation.",
      "xml": [],
      "sources": [
        {
          "group": "stonecutting",
          "type": "RimWorld.Bill_Production",
          "file": ".local-research/stonecutting/RimWorld.Bill_Production.cs",
          "sha256": "0881bb3ba1111a7aa16f7d05d91d882847341dfb8cf108eb004c500a5738aba4",
