  "claims": [
    {
      "id": "PB01",
      "finding": "Production bills support RepeatCount, Forever and TargetCount. Default constructor fields are RepeatCount, repeatCount1, targetCount10 and unpauseWhenYouHave5. Target mode selection checks recipe.WorkerCounter.CanCountProducts; the generic counter accepts one regular product and no specialProducts, while custom counters may override.",
      "xml": [
        "PBX01"
      ],
      "sources": [
        {
          "group": "stonecutting",
          "type": "RimWorld.Bill_Production",
