    {
      "id": "DC15",
      "finding": "Selected base furniture: Stool comfort0.5/stuff25/work450; DiningChair0.70/45/8000; Armchair0.8/110/14000; Table1x2c stuff28/work750 inherits Eat surface. Quality factors for Comfort are0.76/0.88/1/1.12/1.24/1.45/1.7. Material/quality/effective modded values are separate.",
      "sources": [
        {
          "file": ".local-research/housing/RimWorld.PawnUtility.cs",
