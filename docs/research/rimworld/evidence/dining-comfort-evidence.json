    {
      "id": "DC16",
      "finding": "IngestibleProperties defaults: baseIngestTicks500,chairSearchRadius32,useEatingSpeedStat=true,ingestHoldUsesTable=true,tableDesired=true. XML children can override these; the selected meals and their parent chain are retained separately.",
      "sources": [
        {
          "file": ".local-research/survival/RimWorld.IngestibleProperties.cs",
          "sha256": "12330427e18b72374f1e0020c92a0cb94aa16a47fc61476375e1f9083f61cbfe",
