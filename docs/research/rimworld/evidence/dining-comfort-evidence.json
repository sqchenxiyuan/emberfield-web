  "manifest": "dining-comfort-manifest.json",
  "types": "dining-comfort-types.json",
  "claims": [
    {
      "id": "DC01",
      "finding": "Ingest is prepare -> chew -> finalize. Food must remain ingestible and reachable/carried; food pickup enters carry and changes targetA. Nutrition and item consumption occur at FinalizeIngest/Thing.Ingested, not when selecting a seat.",
      "sources": [
        {
          "file": ".local-research/food/RimWorld.JobDriver_Ingest.cs",
          "sha256": "278d66fed21ad28e41fb21c8af49f224a73c4163a26067431fe6eee0768ec3c6",
          "lines": [
            91,
            173
          ]
        },
        {
          "file": ".local-research/food/RimWorld.Toils_Ingest.cs",
          "sha256": "2e10eef89dc2f5d216681188952eb0227d1dd04d459463256a162310c30d9bb7",
          "lines": [
            43,
            69
          ]
        },
        {
          "file": ".local-research/food/RimWorld.Toils_Ingest.cs",
          "sha256": "2e10eef89dc2f5d216681188952eb0227d1dd04d459463256a162310c30d9bb7",
          "lines": [
            395,
            438
          ]
        }
      ],
      "xml": []
    },
    {
      "id": "DC02",
      "finding": "Tool users take food from inventory or walk to food and pick it up. Non-manipulating pawns and non-tool-users use distinct paths. Drafted tool users skip CarryIngestibleToChewSpot; this is not a universal always-go-to-table rule.",
      "sources": [
        {
          "file": ".local-research/food/RimWorld.JobDriver_Ingest.cs",
          "sha256": "278d66fed21ad28e41fb21c8af49f224a73c4163a26067431fe6eee0768ec3c6",
          "lines": [
            120,
            173
          ]
        }
      ],
      "xml": []
    },
    {
      "id": "DC03",
      "finding": "Seat search uses food chairSearchRadius. It first finds a reachable safe sittable with a free cell, same faction for player pawns, not forbidden/fogged/burning/hostile and socially proper. The seat cell must have a cardinally adjacent Eat surface. A standalone chair is not a normal dining-seat candidate.",
      "sources": [
        {
          "file": ".local-research/food/RimWorld.Toils_Ingest.cs",
          "sha256": "2e10eef89dc2f5d216681188952eb0227d1dd04d459463256a162310c30d9bb7",
          "lines": [
            94,
            196
          ]
        }
      ],
      "xml": [
        "DX01",
        "DX02"
      ]
    },
    {
      "id": "DC04",
      "finding": "A chosen seat/standing cell is reserved plus a destination reservation, then reached by path. CanReserveSittableOrSpot checks forbidden/impassable cells and conflicting nearby interaction cells; multi-sittable furniture reserves its specific cell, ordinary chairs reserve the building.",
      "sources": [
        {
          "file": ".local-research/food/RimWorld.Toils_Ingest.cs",
          "sha256": "2e10eef89dc2f5d216681188952eb0227d1dd04d459463256a162310c30d9bb7",
          "lines": [
            71,
            92
          ]
        },
        {
          "file": ".local-research/dining-comfort/Verse.AI.ReservationUtility.cs",
          "sha256": "7cf1c88ad1ccd1baff46192348b69e5ca3d02f5580b165d6e215c0ff81373123",
          "lines": [
            9,
            61
          ]
        }
      ],
      "xml": []
    },
    {
      "id": "DC05",
      "finding": "No safe eligible chair falls back to a standing chewing spot. Dangerous standing candidates can trigger a second chair search no more dangerous than that spot. Complete failure starts a path to the current cell and logs a warning, rather than making all eating impossible.",
      "sources": [
        {
          "file": ".local-research/food/RimWorld.Toils_Ingest.cs",
          "sha256": "2e10eef89dc2f5d216681188952eb0227d1dd04d459463256a162310c30d9bb7",
          "lines": [
            71,
            134
          ]
        },
        {
          "file": ".local-research/dining-comfort/RimWorld.RCellFinder.cs",
          "sha256": "0e83eda4be1562dd2c2670f951bea3fad86125391416226783464d617e9f95c9",
          "lines": [
            1018,
            1138
          ]
        }
      ],
      "xml": []
    },
    {
      "id": "DC06",
      "finding": "FindAdjacentEatSurface picks a cardinally adjacent Eat surface and faces it. Carried food can be rendered over that surface while the pawn is stationary; this draw position is not a drop, ground stack or table inventory transaction.",
      "sources": [
        {
          "file": ".local-research/food/RimWorld.Toils_Ingest.cs",
          "sha256": "2e10eef89dc2f5d216681188952eb0227d1dd04d459463256a162310c30d9bb7",
          "lines": [
            227,
            291
          ]
        },
        {
          "file": ".local-research/food/RimWorld.JobDriver_Ingest.cs",
          "sha256": "278d66fed21ad28e41fb21c8af49f224a73c4163a26067431fe6eee0768ec3c6",
          "lines": [
            238,
            263
          ]
        }
      ],
      "xml": []
    },
    {
      "id": "DC07",
      "finding": "Chewing duration is rounded baseIngestTicks times duration multiplier; multiplier is reciprocal EatingSpeed unless useEatingSpeedStat=false. Chewing stops movement, uses a physical interaction reservation for spawned food, releases that reservation on finish, and calls GainComfortFromCellIfPossible every tick interval.",
      "sources": [
        {
          "file": ".local-research/food/RimWorld.JobDriver_Ingest.cs",
          "sha256": "278d66fed21ad28e41fb21c8af49f224a73c4163a26067431fe6eee0768ec3c6",
          "lines": [
            41,
            53
          ]
        },
        {
          "file": ".local-research/food/RimWorld.Toils_Ingest.cs",
          "sha256": "2e10eef89dc2f5d216681188952eb0227d1dd04d459463256a162310c30d9bb7",
          "lines": [
            294,
            353
          ]
        }
      ],
      "xml": [
        "DX02"
      ]
    },
    {
      "id": "DC08",
      "finding": "Dining memories require mood, nutrition-giving food, and chairSearchRadius>10. AteWithoutTable additionally needs Standing, not WildMan, tableDesired, and no Eat surface immediately in front. Missing chair alone does not establish this memory; present tables elsewhere do not prevent it.",
      "sources": [
        {
          "file": ".local-research/food/RimWorld.Toils_Ingest.cs",
          "sha256": "2e10eef89dc2f5d216681188952eb0227d1dd04d459463256a162310c30d9bb7",
          "lines": [
            395,
            417
          ]
        }
      ],
      "xml": [
        "DX02",
        "DX03"
      ]
    },
    {
      "id": "DC09",
      "finding": "AteWithoutTable lasts1day, stackLimit1, mood-3; Ascetic and the indicated Ideology precept nullify it. FinalizeIngest has no branch clearing an existing memory after later table use; memory age/refresh must be distinguished from mere presence in a save.",
      "sources": [
        {
          "file": ".local-research/food/RimWorld.Toils_Ingest.cs",
          "sha256": "2e10eef89dc2f5d216681188952eb0227d1dd04d459463256a162310c30d9bb7",
          "lines": [
            395,
            438
          ]
        }
      ],
      "xml": [
        "DX03"
      ]
    },
    {
      "id": "DC10",
      "finding": "Dining-room memory uses current room Impressiveness score stage and a non-null thought stage; this call does not test RoomRole DiningRoom, require a table/chair, or explicitly reject outdoor rooms. Stages0..2 are null; stages3..9 give+2..+8,1day,stackLimit1.",
      "sources": [
        {
          "file": ".local-research/food/RimWorld.Toils_Ingest.cs",
          "sha256": "2e10eef89dc2f5d216681188952eb0227d1dd04d459463256a162310c30d9bb7",
          "lines": [
            407,
            417
          ]
        }
      ],
      "xml": [
        "DX04"
      ]
    },
    {
      "id": "DC11",
      "finding": "Comfort is a seeker need, not an instant chair bonus. CurInstantLevel uses clamped lastComfortUsed only while lastComfortUseTick>=TicksGame-15, otherwise0; category thresholds are0.1,0.6,0.7,0.8,0.9.",
      "sources": [
        {
          "file": ".local-research/housing/RimWorld.Need_Comfort.cs",
          "sha256": "94539efb01eda893d840c69635e3c7e03256de7d13b99b58f4b2df21397990bd",
          "lines": [
            1,
            81
          ]
        }
      ],
      "xml": [
        "DX05"
      ]
    },
    {
      "id": "DC12",
      "finding": "GainComfortFromCell samples the building under the pawn on its15tick hash interval; acceptable nonnegative Comfort stats call ComfortUsed. Chewing uses this without chairsOnly. Furniture elsewhere in the room does not feed this method.",
      "sources": [
        {
          "file": ".local-research/housing/RimWorld.PawnUtility.cs",
          "sha256": "1f60bf4b888af7c96d0fb159c2347ff9335a9ff59596002507951742b350c941",
          "lines": [
            317,
            339
          ]
        },
        {
