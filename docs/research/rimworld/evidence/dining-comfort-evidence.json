          "sha256": "2e10eef89dc2f5d216681188952eb0227d1dd04d459463256a162310c30d9bb7",
          "lines": [
            313,
            334
          ]
        }
      ],
      "xml": [
        "DX01",
        "DX06"
      ]
    },
    {
      "id": "DC13",
      "finding": "Need_Seeker moves toward its instant target by seekerRisePerHour*0.06 or seekerFallPerHour*0.06 per NeedInterval and clamps to the target; Comfort defines0.60/hour rise and0.04/hour fall. This does not fill comfort in one meal.",
      "sources": [
        {
          "file": ".local-research/housing/RimWorld.Need_Seeker.cs",
          "sha256": "ba9490ff38079453846eb04d11b6cafa57e70b3a12b17e029d836e4930301339",
          "lines": [
            1,
            53
          ]
        }
      ],
      "xml": [
        "DX05"
      ]
    },
    {
      "id": "DC14",
      "finding": "NeedComfort is a situation thought: Uncomfortable gives-3; Normal is inactive; higher categories give+4,+6,+8,+10. It is distinct from the time-limited AteWithoutTable and AteInImpressiveDiningRoom memories.",
      "sources": [
        {
          "file": ".local-research/dining-comfort/RimWorld.ThoughtWorker_NeedComfort.cs",
