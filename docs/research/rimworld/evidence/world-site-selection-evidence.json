  "claims": [
    {
      "id": "WS01",
      "kind": "static-derived",
      "finding": "World generation and WorldInfo.Seed both use GenText.StableStringHash(seedString): null=>0, otherwise signed32 accumulation starting23, each UTF16 code unit multiplies by31 then adds the code unit. World seed text is stored separately from its derived integer.",
