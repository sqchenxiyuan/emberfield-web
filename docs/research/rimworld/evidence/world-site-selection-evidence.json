    {
      "id": "WS02",
      "kind": "static-derived",
      "finding": "PlanetTile is tileId plus layer identity. Its hash is signed32(tileId*397) XOR effectiveLayer, with effectiveLayer0 when layerId<0 or Layer.IsRootSurface, otherwise layerId. Tile ID alone is not the ordinary local-map hash input; root-surface aliases normalize. This finite hash is not a collision-free world identity.",
      "sources": [
        {
          "group": "world-site-selection",
          "type": "RimWorld.Planet.PlanetTile",
          "file": ".local-research/world-site-selection/RimWorld.Planet.PlanetTile.cs",
          "sha256": "bca7cbd1976a035353bf44fde8eb4b6b1e04a2c9eb42bfddaf2763a10cee45a9",
          "lines": [
            6,
            78
          ]
        }
      ],
      "prior": []
    },
    {
      "id": "WS03",
      "kind": "static-derived",
      "finding": "Ordinary GenerateMap derives HashCombineInt(world.info.Seed,parent.Tile.GetHashCode()); missing parent falls back0. Pocket-map path uses parent.ID or Rand.Int instead. HashCombineInt combines seed with value+2654435769+(seed<<6)+(seed>>2), then XOR and signed32 cast. Generation steps sort order,index and derive per-step seeds; this is not full map equivalence across versions, Defs, size or parameters.",
      "sources": [
        {
          "group": "world-site-selection",
          "type": "Verse.Gen",
          "file": ".local-research/world-site-selection/Verse.Gen.cs",
          "sha256": "caaa3bad1e7b4db2e1b2a14a3c441fb5e0140e1496d47eade168d3209e6b1f01",
