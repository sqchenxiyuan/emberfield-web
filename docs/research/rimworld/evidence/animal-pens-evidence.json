    },
    {
      "id": "AP19",
      "finding": "Pen rebalancing compares total BodySize divided by district cell count, with candidate density*1.2<other density. It can account for animals being moved. This density test is not the displayed nutrition-capacity estimate or a hard maximum animal count.",
      "sources": [
        {
          "file": ".local-research/animal-pens/Verse.AnimalPenBalanceCalculator.cs",
          "sha256": "c51e53ad60aba0376caeec644aa8bfcc85419f3bbdd51e79adb8d2244e085130",
