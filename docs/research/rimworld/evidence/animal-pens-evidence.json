    {
      "id": "AP12",
      "finding": "Rope attachment needs a valid cardinally adjacent interaction cell that both participants can occupy. Ordinary job walks there, attaches, and waits30ticks, also temporarily putting the animal into Wait. Pen destination is a reachable reservable cell in connected pen regions, not the marker tile itself.",
      "sources": [
        {
          "file": ".local-research/husbandry-reproduction/Verse.AnimalPenUtility.cs",
          "sha256": "fbc92dcf75908d45f445f835fc83d0f9251cdd3c7d84482a27fdcd91d524b3f9",
