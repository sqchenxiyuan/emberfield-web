      "xml": []
    },
    {
      "id": "AP16",
      "finding": "SupportsAllowedAreas is !Roamer and !disableAreaControl. Loading a roamer clears allowed areas. SeekAllowedArea requests an ordinary reachable Goto into allowed space and can interrupt forbidden goals; area restrictions are behavioral preferences, not walls or teleportation.",
      "sources": [
        {
          "file": ".local-research/animal-pens/RimWorld.Pawn_PlayerSettings.cs",
          "sha256": "c23d3b5de6c9a96cad59170531efc71f3964d8d99d07b582eda580bfbdd00494",
