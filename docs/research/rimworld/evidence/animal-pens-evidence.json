    {
      "id": "AP18",
      "finding": "Roaming finds a reachable exit; absence of exit or a new rope recovers the state. Within12cells of the exit it starts a7000..8000tick wait; ShouldExitMapNow also becomes true after state age>60000. Recovery starts a30000tick cooldown. Final map-exit job behavior is outside this extraction.",
      "sources": [
        {
          "file": ".local-research/animal-pens/Verse.AI.MentalState_Roaming.cs",
          "sha256": "430396200cf3709a207cabc133c895da1ac7815ee9013e9a20c90ab4a77bf70f",
