      "xml": []
    },
    {
      "id": "AP13",
      "finding": "RopeToDestination may add nearby animals for the same destination up to default10, within10cells; movement uses the slowest ropee. Animal FollowRoper uses paths and a follow distance7.2; nominal RopeLength is8. This is not instantaneous relocation.",
      "sources": [
        {
          "file": ".local-research/animal-pens/RimWorld.JobDriver_RopeToDestination.cs",
          "sha256": "a806f6ce107f14ff991ea303599f4495e339a418bf75c6e3913069ae7b99dfd9",
