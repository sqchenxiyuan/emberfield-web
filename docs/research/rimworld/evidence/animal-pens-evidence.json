    {
      "id": "AP17",
      "finding": "A breach does not immediately remove ownership or delete the animal. Natural Roaming requires spawned/playerhome/player faction/Roamer, >=300000ticks since game start, not roped, no roaming cooldown, and reachability to the map edge. Chance node reads species RoamMtbDays;2days is not a fixed escape timer.",
      "sources": [
        {
          "file": ".local-research/animal-pens/Verse.AI.MentalStateWorker_Roaming.cs",
          "sha256": "9f8999c267144eb76af765e5b748146c9cbe18b82356b317e6cd8207f1e001ae",
