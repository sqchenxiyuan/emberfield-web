      "xml": []
    },
    {
      "id": "AP15",
      "finding": "Roping state is saved as bidirectional references. Death, downing, drafting, fire, sleeping ropee, incompatible mental state, an incompatible roper job or loss of mutual reachability can break the link. Roping and ownership are independent.",
      "sources": [
        {
          "file": ".local-research/animal-pens/RimWorld.Pawn_RopeTracker.cs",
          "sha256": "d087455d61013c929ceb6d3ed3f28794ee1764ee56dd7ce1b2697ba6c87dc7c7",
