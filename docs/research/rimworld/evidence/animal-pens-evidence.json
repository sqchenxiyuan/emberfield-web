    {
      "id": "AP10",
      "finding": "TakeToPen requires an eligible same-faction roaming species on a player home map, reservation and interaction access. Animals in a non-Roaming mental state or designated release-to-wild are rejected; roper allowed-area restrictions matter. Roping explicitly ignores minimum handling skill, unlike taming.",
      "sources": [
        {
          "file": ".local-research/animal-pens/RimWorld.WorkGiver_TakeToPen.cs",
          "sha256": "728a07f39e46113296a226d68d4791b0d1b88a51060d6b883fc13c7efa025cb1",
