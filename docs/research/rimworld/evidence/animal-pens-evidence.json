      "xml": []
    },
    {
      "id": "AP14",
      "finding": "RopeToPen releases each animal when its own region belongs to the pen connected regions; reaching the exact marker is unnecessary. The finish action drops ropes. If the destination ceases to be enclosed, arrival logic returns true and drops ropes rather than preserving containment.",
      "sources": [
        {
          "file": ".local-research/animal-pens/RimWorld.JobDriver_RopeToPen.cs",
          "sha256": "901903f0c10f62e0373c74a0ea8b40a6f15e1ccbf4136a14ba09af179b73a09a",
