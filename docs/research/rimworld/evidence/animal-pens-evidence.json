      "xml": []
    },
    {
      "id": "AP05",
      "finding": "RoamerCanPass(door) uses door.FreePassage OR building.roamerCanOpen. FreePassage needs Open and then HoldOpen or not WillCloseSoon. A transiently opened automatic-closing gate is not equivalent to a held-open boundary.",
      "sources": [
        {
          "file": ".local-research/animal-pens/Verse.AnimalPenEnclosureCalculator.cs",
          "sha256": "feb4fadf81cb9327301d996b56b65825c9b21cbbacbdba246b8acdbaab26274c",
