  {
    "id": "PL07",
    "kind": "xml-and-static-derived",
    "statement": "AdjacentSowBlocker inspects8 neighbors: neighbor.blockAdjacentSow OR(target.blockAdjacentSow AND neighbor.sown). TreeBase blocks neighbors; ordinary unsown nonblocking grass does not trigger this rule. Wild cluster radius8 is unrelated to sow spacing. Reviewed player sow path has no global forest density cap.",
    "sources": [
      {
        "group": "generation",
        "type": "RimWorld.PlantUtility",
        "line_start": 301,
        "line_end": 315
      },
      {
