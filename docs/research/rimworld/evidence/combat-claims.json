        "member": "AimOnTargetChance_StandardTarget / TotalEstimatedHitChance",
        "line_start": 34,
        "line_end": 78
      }
    ],
    "values": {
      "minimum_standard_aim": 0.0201,
      "prone_distance_min": 4.5,
      "prone_factor": 0.5,
      "execution_distance_max": 3.9,
      "execution_factor": 7.5
    }
  },
  {
    "id": "CB02",
    "kind": "static-derived",
    "statement": "射手命中因子以每格精度a的distance次幂起算，再乘3/12/25/40格节点间的射手距离修正；不是把人物射击属性直接当整发命中率。",
