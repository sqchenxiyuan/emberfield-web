  "claims": [
    {
      "id": "FQ01",
      "finding": "Only furniture with inherited CompQuality gets a quality roll. Bed, DiningChair and Table1x2c have the component; HorseshoesPin has none. TryGetQuality returns false with Normal output for no component; StatRequest uses this computational fallback without adding a quality component.",
      "sources": [
        {
          "file": ".local-research/weapons/RimWorld.QualityUtility.cs",
          "sha256": "5405ad9826ffab0e283ce40bb11529a1f2f9a17dc7766aa8a24efd6c977e8821",
          "lines": [
            1,
            372
          ]
        },
        {
          "file": ".local-research/furniture-quality/RimWorld.StatRequest.cs",
          "sha256": "80182f036ca037ef77d377f1a2d90bd41788341e33272b46ddd58055726bff41",
          "lines": [
            54,
            98
          ]
        }
      ],
      "xml": [
        "FQX01",
        "FQX02",
        "FQX03"
      ]
    },
    {
      "id": "FQ02",
      "finding": "Ordinary FinishFrame reserves an accessible player frame with materials and valid skills. Work increments ConstructionSpeed*1.7*delta, with Stuff ConstructionSpeedFactor; Construction XP .25*delta when resources and skills exist. Failure check is independent of quality: 1-pow(ConstructSuccessChance, workIncrement/workRequired).",
      "sources": [
        {
          "file": ".local-research/skills/RimWorld.JobDriver_ConstructFinishFrame.cs",
          "sha256": "e62e8a4546b450eab544166f2a2c45a9318b3a462155f9d9337959ac75212373",
          "lines": [
            1,
            90
          ]
        },
        {
          "file": ".local-research/anatomy/RimWorld.WorkGiver_ConstructFinishFrames.cs",
          "sha256": "9f8019bb9f315462413fbf4aafcb6e46881cdf0dedec68836a066f7e1e9b9042",
          "lines": [
            1,
            45
          ]
        }
      ],
      "xml": []
    },
    {
      "id": "FQ03",
      "finding": "On workDone>=WorkToBuild, CompleteConstruction(actor) creates the finished thing and sets quality once using that finishing actor current Construction skill. It destroys frame resources, handles art, inherits ceil(frameHP/frameMaxHP*finishedMaxHP), spawns the result and increments ThingsConstructed. It is not the planner or mean contributor skill.",
      "sources": [
        {
          "file": ".local-research/storyteller/RimWorld.Frame.cs",
          "sha256": "217487cdf961231343784de7f05141c4d9d4b933a18d41dba9655b6e804c98fc",
          "lines": [
            262,
            375
          ]
        },
        {
          "file": ".local-research/skills/RimWorld.JobDriver_ConstructFinishFrame.cs",
          "sha256": "e62e8a4546b450eab544166f2a2c45a9318b3a462155f9d9337959ac75212373",
          "lines": [
            39,
            80
          ]
        }
      ],
      "xml": []
    },
    {
      "id": "FQ04",
      "finding": "Quality uses skill-level centers, asymmetric Gaussian .6/.8, integer truncation and clamp0..5; a rolled Masterwork has50% reroll using .6/.95. Inspired_Creativity adds2 capped6; pawn overload can consume inspiration. Mech skill and ideology production-role offset are separate branches. No exact probability table is inferred.",
      "sources": [
        {
          "file": ".local-research/weapons/RimWorld.QualityUtility.cs",
          "sha256": "5405ad9826ffab0e283ce40bb11529a1f2f9a17dc7766aa8a24efd6c977e8821",
          "lines": [
            160,
            267
          ]
        }
      ],
      "xml": []
    },
    {
      "id": "FQ05",
      "finding": "CompQuality runtime field starts Normal but serialized missing quality defaults Awful. Existing saved quality persists; SetQuality also handles art and post-quality callbacks. Missing quality on a thing without CompQuality means no quality, not Awful.",
      "sources": [
        {
          "file": ".local-research/armor/RimWorld.CompQuality.cs",
          "sha256": "e07103ce60d82c815919c0726d577f41bb8a46a9c932be2eee5c37c48af255bc",
          "lines": [
            1,
            54
          ]
        }
      ],
      "xml": [
        "FQX02",
        "FQX03"
      ]
    },
    {
      "id": "FQ06",
      "finding": "CompArt records authorName only when CanShowArt is true. Bed and DiningChair inherit minimum artistic quality Excellent. Poor beds therefore need not retain creator name or pawn ID. Finished-actor attribution can use before-job and after-construction evidence; a web craftedBy field would be additional provenance.",
      "sources": [
        {
          "file": ".local-research/furniture-quality/RimWorld.CompArt.cs",
          "sha256": "8a83193ec7926babdb098df8224ce0ea6830e3b3baf8adb90aa3cdc250b8998d",
