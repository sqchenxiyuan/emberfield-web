      "nodes": [
        "<NeedDef><defName>Joy</defName><needClass>Need_Joy</needClass><label>recreation</label><description>Recreation is the need to have fun. Repeating the same kind of activity makes it less fun, so variety is necessary.</description><minIntelligence>Humanlike</minIntelligence><colonistsOnly>true</colonistsOnly><neverOnPrisoner>true</neverOnPrisoner><neverOnSlave>true</neverOnSlave><listPriority>500</listPriority><major>true</major><freezeWhileSleeping>true</freezeWhileSleeping><freezeInMentalState>true</freezeInMentalState><developmentalStageFilter>Adult</developmentalStageFilter></NeedDef>"
      ]
    },
    {
      "id": "XML03",
      "file": "Data/Core/Defs/Misc/PrisonerInteractionModeDefs/PrisonerInteractionMode.xml",
      "source_sha256": "6e9fb8e1b5bc7259d3229025d09a9133e18b29768bafe3ccebd724629069d355",
      "xpath": "/Defs/PrisonerInteractionModeDef[defName=\"MaintainOnly\" or defName=\"AttemptRecruit\" or defName=\"ReduceResistance\" or defName=\"Release\"]",
      "nodes": [
        "<PrisonerInteractionModeDef><defName>MaintainOnly</defName><label>maintain only</label><listOrder>0</listOrder><description>Just feed the prisoner and provide for their basic needs, without attempting any other interaction.</description></PrisonerInteractionModeDef>",
        "<PrisonerInteractionModeDef><defName>AttemptRecruit</defName><label>recruit</label><listOrder>10</listOrder><allowOnWildMan>False</allowOnWildMan><description>Wardens will attempt to recruit the prisoner. If the prisoner still has resistance, wardens will speak to them to reduce it.</description><hideIfNotRecruitable>true</hideIfNotRecruitable></PrisonerInteractionModeDef>",
        "<PrisonerInteractionModeDef><defName>ReduceResistance</defName><label>reduce resistance only</label><isChildInteraction>true</isChildInteraction><listOrder>11</listOrder><allowOnWildMan>False</allowOnWildMan><description>If the prisoner still has resistance, wardens will speak to them to reduce it. No recruit attempts will be made.</description><hideIfNotRecruitable>true</hideIfNotRecruitable></PrisonerInteractionModeDef>",
        "<PrisonerInteractionModeDef><defName>Release</defName><label>release</label><listOrder>35</listOrder><description>A warden will release the prisoner.</description></PrisonerInteractionModeDef>"
      ]
    },
