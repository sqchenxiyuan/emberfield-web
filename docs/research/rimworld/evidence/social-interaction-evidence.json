    {
      "id": "SC02",
      "finding": "Random eligibility is asymmetric: initiator requires interaction tracker, Talking, awake, no fire/block, humanlike, not downed/aggressive, faction and life-stage permission; receiver does not repeat Talking/Hearing requirements. Position requires horizontal range6 and line of sight. Mental-state blocks, blocking hediffs and lord restrictions are checked through PawnUtility.",
      "sources": [
        {
          "file": ".local-research/social-interaction/RimWorld.SocialInteractionUtility.cs",
          "sha256": "37c607613ebca2640d0e0d224c888e6a879f028ad90fbaad38bd0cd1d92555ae",
