    },
    {
      "id": "OUT13",
      "finding": "ValidateSettings validates storeGroup and includeGroup independently. Invalid output reference becomes null and Specific becomes DropOnFloor. Zone registration, single-building haul-group registration, and StorageGroup manager membership have different validity checks. Validation does not clear a reference solely for filter incompatibility or no free cells.",
      "sources": [
        {
          "group": "stonecutting",
          "type": "RimWorld.Bill_Production",
          "file": ".local-research/stonecutting/RimWorld.Bill_Production.cs",
          "sha256": "0881bb3ba1111a7aa16f7d05d91d882847341dfb8cf108eb004c500a5738aba4",
