    {
      "id": "OUT04",
      "finding": "For Best/Specific only products[0] is considered for maker delivery; products[1..] are placed Near the maker. Ordinary recipe product definitions are yielded in list order; special product routines can yield multiple Things. A Thing stackCount may exceed a normal stack limit until subsequent carry/placement splitting. First product is not the most valuable or nearest product.",
      "sources": [
        {
          "group": "food",
          "type": "Verse.AI.Toils_Recipe",
          "file": ".local-research/food/Verse.AI.Toils_Recipe.cs",
