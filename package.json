{
  "name": "emberfield-colony",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5178 --strictPort",
    "check": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4178 --strictPort",
    "test": "vitest run",
    "test:browser": "node scripts/browser-verify.mjs",
    "test:campaign": "node scripts/campaign-verify.mjs",
    "test:seeds": "node scripts/seeds-verify.mjs",
    "test:memory": "node scripts/memory-verify.mjs",
    "test:performance": "node scripts/simulation-benchmark.mjs"
  },
  "dependencies": {
    "pixi.js": "8.22.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "0.28.2",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^3.2.4"
  }
}
