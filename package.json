    "test:voxel:stonecutting:browser": "node scripts/voxel-stonecutting-browser-verify.mjs",
    "test:seeds": "node scripts/seeds-verify.mjs",
    "test:memory": "node scripts/memory-verify.mjs",
    "test:performance": "node scripts/simulation-benchmark.mjs",
    "test:voxel:worldgen": "node scripts/voxel-worldgen-campaign-verify.mjs",
    "test:voxel:worldgen:browser": "node scripts/voxel-worldgen-browser-verify.mjs",
    "test:voxel:plants": "node scripts/voxel-plants-campaign-verify.mjs",
